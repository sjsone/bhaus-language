{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    ["(", ")"],
    ["[", "]"]
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(PROTOCOL|STRUCT|CLASS)\\s+[a-zA-Z_][a-zA-Z0-9_]*(/[a-zA-Z_][a-zA-Z0-9_]*)*\\s*:",
    "decreaseIndentPattern": "^\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*:"
  }
}
