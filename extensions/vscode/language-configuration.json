{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    ["(", ")"],
    ["[", "]"]
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(PROTOCOL|STRUCT|CLASS|SYSTEM|CONTAINER|COMPONENT)\\b.*:\\s*(#.*)?$"
  }
}
